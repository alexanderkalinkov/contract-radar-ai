# Copy this file to .env.local and fill in what you need. Every value is optional.

# Claude reads uploaded contracts. Without it, uploads return a sample extraction.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Supabase turns on login, a shared team workspace and saved contracts.
# Without these the app runs in demo mode (no login, uploads saved in your browser only).
# Supabase dashboard → Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server only (never prefix with NEXT_PUBLIC_). Lets team invites use Supabase's
# "You have been invited" email. Without it, invitees get a sign-in link instead.
SUPABASE_SERVICE_ROLE_KEY=

# Auto-discovery (Discovered tools page): find paid tools in accounting and sign-in data.
# Step-by-step setup for each provider: docs/auto-discovery-setup.md. Each one is optional.
# Encrypts stored sign-in tokens. Make one with: openssl rand -base64 32 (never change it later).
CONNECTOR_ENCRYPTION_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (Intuit test company) or production
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: force the base of OAuth redirect URLs, e.g. https://contract-radar-ai.vercel.app
APP_URL=

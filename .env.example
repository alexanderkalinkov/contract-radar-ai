# Copy this file to .env.local and fill in what you need. Every value is optional.

# Claude reads uploaded contracts. Without it, uploads return a sample extraction.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Supabase turns on login, a shared team workspace and saved contracts.
# Without these the app runs in demo mode (no login, uploads saved in your browser only).
# Supabase dashboard → Project Settings → API (or "Connect").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server only (never prefix with NEXT_PUBLIC_). Lets team invites use Supabase's
# "You have been invited" email. Without it, invitees get a sign-in link instead.
SUPABASE_SERVICE_ROLE_KEY=

# Auto-discovery (Discovered tools page): find paid tools in accounting and sign-in data.
# Step-by-step setup for each provider: docs/auto-discovery-setup.md. Each one is optional.
# Encrypts stored sign-in tokens. Make one with: openssl rand -base64 32 (never change it later).
CONNECTOR_ENCRYPTION_KEY=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (Intuit test company) or production
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The app's public address, e.g. https://contract-radar-ai.vercel.app (later your real domain).
# Used for OAuth redirect URLs and for every link and the logo in emails. Defaults to the Vercel URL.
APP_URL=

# Email: renewal reminders and branded team invites (docs/email-setup.md).
# A Resend API key with sending access (the same Resend account Supabase Auth uses for SMTP).
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Change it when the real domain is live.
EMAIL_FROM="Contract Radar <alerts@your-domain.com>"
# Optional: where replies go.
EMAIL_REPLY_TO=
# Optional: rename the brand in every email.
EMAIL_BRAND_NAME=
# Optional: when reminders go out, in days before each date (default 90,60,30).
RENEWAL_ALERT_DAYS=
# Protects the daily reminder job (/api/cron/renewal-alerts). Make one with: openssl rand -hex 32
# Vercel Cron sends it automatically once it's set in the Vercel project.
CRON_SECRET=

# Email contracts in: each workspace gets an inbox address (docs/email-inbox-setup.md).
# The receiving domain: your Resend "<id>.resend.app" address domain now, e.g. in.yourdomain.com later.
INBOUND_EMAIL_DOMAIN=
# Signing secret (whsec_...) of the Resend webhook for email.received pointing at <APP_URL>/api/inbound/resend.
RESEND_WEBHOOK_SECRET=
# Optional: a Resend API key with full access, used to read received mail. Defaults to RESEND_API_KEY.
RESEND_INBOUND_API_KEY=
# Optional: "true" accepts mail even when SPF/DKIM/DMARC can't confirm the sender. Leave off in production.
INBOUND_TRUST_UNVERIFIED_SENDERS=

# Billing: Stripe plans and the 14-day free trial (docs/billing-setup.md).
# Without STRIPE_SECRET_KEY billing is off: nothing is charged and nothing is locked.
# Use the test keys (sk_test_...) until you go live.
STRIPE_SECRET_KEY=
# Signing secret of the webhook pointing at <APP_URL>/api/stripe/webhook (npm run stripe:setup -- <APP_URL> prints it).
STRIPE_WEBHOOK_SECRET=
# Optional: "true" lets Stripe Tax add VAT to invoices (turn Stripe Tax on in the dashboard first).
STRIPE_AUTOMATIC_TAX=

# Legal pages (/legal/privacy, /legal/terms, /legal/dpa, /legal/subprocessors). See docs/legal-pages.md.
# Until these are set the pages show [placeholders]. APP_URL above sets the domain they mention.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Set to true once a lawyer has reviewed the pages, to hide the "Draft for legal review" banner.
LEGAL_REVIEWED=

# Help & support (docs/help-and-support.md).
# Where "Contact support" messages go. Falls back to LEGAL_EMAIL, then EMAIL_REPLY_TO. Sent through Resend (RESEND_API_KEY).
SUPPORT_EMAIL=
# Optional: the onboarding video. Defaults to <NEXT_PUBLIC_SUPABASE_URL>/storage/v1/object/public/help/contract-radar-onboarding.mp4
HELP_VIDEO_URL=
